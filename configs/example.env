# 阿里云百炼/千问 API Key。不要提交真实密钥。
DASHSCOPE_API_KEY=

# OpenAI 兼容接口地址（推荐）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称（qwen3.5-flash 性价比最高）
QWEN_MODEL=qwen3.5-flash

# PostgreSQL 数据库连接
DB_DSN=postgres://localhost:5432/aigo?sslmode=disable

# JWT 密钥（必填！不得使用默认值，serve 启动时会强制校验）
JWT_SECRET=your-secret-key-here

# 是否开放用户自助注册（默认关闭，改为 1 或 true 开启）
AIGO_REGISTER_ENABLED=0

# CORS 跨域来源白名单（逗号分隔，空=禁止跨域。开发环境前端走 Vite 代理为同源，无需设置）
CORS_ALLOWED_ORIGINS=

# 首次启动（空库）创建默认管理员 admin 时的密码；留空则自动生成随机强密码并打印在启动日志中
AIGO_ADMIN_PASSWORD=
