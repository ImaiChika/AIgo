# 实时 AI 配置建议在超级管理员登录后的“AI 服务配置”页面填写。
# 这里的变量仅用于首次启动兼容导入、服务尚未配置时的回退，以及独立的 Batch。
# 不要提交真实密钥。
DASHSCOPE_API_KEY=

# 实时文本推理部署方式：cloud（百炼，默认）或 local（vLLM/SGLang 等）。
QWEN_DEPLOYMENT=cloud

# 实时 OpenAI-compatible 接口地址。
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 云端填写 qwen3.5-flash；本地填写服务实际暴露的模型名，
# 例如 Qwen/Qwen3.5-35B-A3B，不能把两个模型 ID 混用。
QWEN_MODEL=qwen3.5-flash

# 云端/自建网关的实时端点独立凭证。仅在确认 QWEN_BASE_URL 为百炼
# 官方域名时才会兼容复用到百炼批量。
QWEN_API_KEY=

# 本地端点独立凭证；无鉴权时留空。本地模式只读取此变量，不会自动发送
# QWEN_API_KEY 或 DASHSCOPE_API_KEY，避免把旧云端凭证泄露给内网服务。
QWEN_LOCAL_API_KEY=

# 思考模式：true / false / auto（空值也表示使用模型服务默认值）。
QWEN_ENABLE_THINKING=auto

# AI 质量检查自动执行：仅在题目首次创建（生成/批量导入/手动新建）后自动触发一次。
# 必须保持为 1：每道题仅在首次生成后自动检查一次；人工修改不复检，也无手动补查。
# 检查任务持久化在 ai_check_tasks 表：重启自动恢复，失败自动重试，耗尽标记最终失败。
AIGO_AICHECK_AUTO=1
# 后台检查 worker 并发数（1-32，默认 2）。
AIGO_AICHECK_CONCURRENCY=2
# 单次检查调用超时（接受 90s / 2m / 纯秒数；默认 90s）。
# 任务租约 = 超时 + 30s 缓冲；worker 崩溃后由租约到期自动回收，不会死锁。
AIGO_AICHECK_TIMEOUT=90s
# 首次检查任务内部自动重试次数上限（1-10，默认 3）；耗尽后阻断流程并展示故障，不再重新入队。
AIGO_AICHECK_MAX_ATTEMPTS=3

# AI 检查端点默认沿用上方 Qwen 实时配置。以下留空即继承；
# 全部留空时不发送任何独立请求头。设置任一项即可让检查走独立模型/端点
# （例如生成走百炼云端、检查走自部署 vLLM）。
# AIGO_AICHECK_DEPLOYMENT=local
# AIGO_AICHECK_BASE_URL=http://127.0.0.1:8000/v1
# AIGO_AICHECK_MODEL=
# AIGO_AICHECK_API_KEY=

# 送审强制前置：开启后题目必须 AI 检查通过（ai_reviewed）才能提交专家审核；
# 人工审核回流状态（需修改/已驳回）不受影响。检查服务故障时可临时设 0 兜底。
# 兼容字段；当前版本始终强制 AI 首检通过后才能送审。
AIGO_REVIEW_REQUIRE_AI_CHECK=1

# PostgreSQL 数据库连接
DB_DSN=postgres://localhost:5432/aigo?sslmode=disable

# 容器/Secret 部署可不用 DB_DSN，改用以下分项配置；两种方式不能混用。
# AIGO_DB_HOST=postgres
# AIGO_DB_PORT=5432
# AIGO_DB_USER=aigo
# AIGO_DB_PASSWORD_FILE=/run/secrets/postgres_password
# AIGO_DB_NAME=aigo
# AIGO_DB_SSLMODE=disable

# HTTP 监听地址。反向代理部署时保持 127.0.0.1；容器内按需设置为 0.0.0.0:8080。
AIGO_HTTP_ADDR=127.0.0.1:8080

# Vite 生产构建目录。开发模式留空并使用 Vite；正式运行脚本会自动指向发布目录。
AIGO_WEB_DIST_DIR=

# 外部 dotenv 文件路径。正式运行默认设为 -，只接受进程环境变量/Secrets；
# 如需文件配置，应指向发布目录之外、权限受控的绝对路径。
AIGO_ENV_FILE=

# JWT 密钥（必填！不得使用默认值，serve 启动时会强制校验）
JWT_SECRET=your-secret-key-here
# 也可改用 JWT_SECRET_FILE=/run/secrets/jwt_secret；不能与 JWT_SECRET 同时设置。

# 是否开放用户自助注册。默认开启；设为 0 或 false 可由管理员临时关闭。
# 新注册用户只有登录/基础浏览能力，业务权限由管理员在「用户管理」分配。
AIGO_REGISTER_ENABLED=1

# 仅当应用确实只接受受控反向代理流量时开启；直连部署保持 false。
AIGO_TRUST_PROXY_HEADERS=false

# 应用日志格式：本地默认 text；容器生产建议 json，便于集中采集与按字段查询。
AIGO_LOG_FORMAT=text

# CORS 跨域来源白名单（逗号分隔，空=禁止跨域。开发环境前端走 Vite 代理为同源，无需设置）
CORS_ALLOWED_ORIGINS=

# 首次启动（空库）创建默认管理员 admin 时的密码；留空则自动生成随机强密码并打印在启动日志中
AIGO_ADMIN_PASSWORD=
