# 阿里云百炼/千问 API Key。不要提交真实密钥。
DASHSCOPE_API_KEY=

# OpenAI 兼容接口地址（推荐）
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型名称（qwen3.5-flash 性价比最高）
QWEN_MODEL=qwen3.5-flash

# PostgreSQL 数据库连接
DB_DSN=postgres://localhost:5432/aigo?sslmode=disable

# JWT 密钥（生产环境请更换）
JWT_SECRET=your-secret-key-here
