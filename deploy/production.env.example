# 复制为 deploy/production.env 后修改。不要把真实配置或密码提交到 Git。
COMPOSE_PROJECT_NAME=aigo

# 本机验收可用 http://localhost；正式公网必须填写已解析到服务器的域名，
# 例如 exam.example.com，Caddy 将自动申请并续期 HTTPS 证书。
AIGO_SITE_ADDRESS=http://localhost
AIGO_HTTP_PORT=80
AIGO_HTTPS_PORT=443

# 实时 Qwen 配置首选在超级管理员登录后的“AI 服务配置”页面填写并切换。
# 下面三项是可选的首次启动兼容/回退配置；若继续使用本地模型，地址必须能从 app 容器内部访问。
QWEN_DEPLOYMENT=cloud
# QWEN_BASE_URL=http://host.docker.internal:8000/v1
# QWEN_MODEL=Qwen/Qwen3.5-35B-A3B
QWEN_ENABLE_THINKING=auto

# 数据库逻辑名/用户；密码位于 deploy/secrets/postgres_password。
AIGO_DB_NAME=aigo
AIGO_DB_USER=aigo
AIGO_REGISTER_ENABLED=1
AIGO_LOG_FORMAT=json
# HTTP 在途请求保护。小服务器先使用保守值；只在压测与运行指标支持时调整。
AIGO_HTTP_MAX_INFLIGHT=64
AIGO_HTTP_EXPENSIVE_MAX_INFLIGHT=8
AIGO_HTTP_HEAVY_MAX_INFLIGHT=2
AIGO_HTTP_RETRY_AFTER_SECONDS=1
TZ=Asia/Shanghai

# 可按服务器容量调整。
AIGO_APP_MEMORY_LIMIT=1g
AIGO_APP_CPU_LIMIT=2.0
AIGO_APP_PIDS_LIMIT=256
AIGO_LOG_MAX_SIZE=20m
AIGO_LOG_MAX_FILES=5

# 逻辑备份：服务启动后立即备份，之后按间隔运行；同时按天数和份数清理。
AIGO_BACKUP_INTERVAL_SECONDS=86400
AIGO_BACKUP_RETENTION_DAYS=14
AIGO_BACKUP_MAX_COUNT=30
AIGO_BACKUP_LOCK_TIMEOUT_SECONDS=30
AIGO_BACKUP_MEMORY_LIMIT=512m
AIGO_BACKUP_CPU_LIMIT=1.0

# 镜像主版本固定；上线前应在客户环境验证并通过变更流程升级。
POSTGRES_IMAGE=postgres:16-alpine@sha256:cf78e76683b9ca8c5733cbbdce6c9262b45b6767934dd0a95e671f9a0fc20685
CADDY_IMAGE=caddy:2-alpine@sha256:5f5c8640aae01df9654968d946d8f1a56c497f1dd5c5cda4cf95ab7c14d58648
AIGO_IMAGE=aigo:local
AIGO_BACKUP_IMAGE=aigo-backup:local

# 异机加密备份默认不启用。完成S3 bucket、Object Lock、凭证和age离线私钥准备后，
# 取消下一行注释以启动offsite profile。应用服务器只保存age公钥。
# COMPOSE_PROFILES=offsite
AIGO_OFFSITE_IMAGE=aigo-offsite:local
AIGO_OFFSITE_AGE_RECIPIENT=
AIGO_OFFSITE_S3_PROVIDER=Other
AIGO_OFFSITE_S3_ENDPOINT=https://s3.example.com
AIGO_OFFSITE_S3_REGION=us-east-1
AIGO_OFFSITE_S3_BUCKET=
AIGO_OFFSITE_S3_PREFIX=aigo
AIGO_OFFSITE_S3_FORCE_PATH_STYLE=true
AIGO_OFFSITE_INTERVAL_SECONDS=300
AIGO_OFFSITE_LOCK_TIMEOUT_SECONDS=30
AIGO_OFFSITE_CONNECT_TIMEOUT=5s
AIGO_OFFSITE_IO_TIMEOUT=30s
AIGO_OFFSITE_HEALTH_GRACE_SECONDS=900
AIGO_OFFSITE_ALLOW_INSECURE_ENDPOINT=0
AIGO_OFFSITE_REQUIRE_OBJECT_LOCK=1
# bucket必须由存储管理员预先开启版本控制和默认Object Lock保留策略，确认后改为1。
AIGO_OFFSITE_BUCKET_OBJECT_LOCK_CONFIRMED=0
AIGO_OFFSITE_MEMORY_LIMIT=512m
AIGO_OFFSITE_CPU_LIMIT=1.0
